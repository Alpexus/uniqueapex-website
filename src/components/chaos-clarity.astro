</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap');
  #ua-chaos .cc-hand{font-family:'Caveat','Segoe Script',cursive}
  #ua-chaos .cc-item{opacity:0;transition:opacity .6s ease}
  #ua-chaos.ua-in .cc-item{opacity:1}
  #ua-chaos .cc-drift{animation:none}
  #ua-chaos.ua-in .cc-drift{animation:ccDrift var(--dur,6s) ease-in-out var(--del,0s) infinite alternate}
  @keyframes ccDrift{from{transform:translateY(-3px)}to{transform:translateY(4px)}}
  #ua-chaos .cc-line{opacity:0;transition:opacity .6s ease}
  #ua-chaos.ua-in .cc-line{opacity:1}
  #ua-chaos .cc-rcard{opacity:0;transform:translateY(10px) scale(.97);transition:opacity .5s ease,transform .5s ease}
  #ua-chaos.ua-in .cc-rcard{opacity:1;transform:none}
  #ua-chaos .cc-center{opacity:0;transform:scale(.94);transition:opacity .55s ease,transform .55s ease;transition-delay:.2s}
  #ua-chaos.ua-in .cc-center{opacity:1;transform:none}
  @media (prefers-reduced-motion: reduce){
    #ua-chaos .cc-item,#ua-chaos .cc-rcard,#ua-chaos .cc-center{opacity:1;transform:none;transition:none}
    #ua-chaos .cc-line{opacity:1;transition:none}
    #ua-chaos.ua-in .cc-drift{animation:none}
  }
  /* ---- mobile flip card (plain CSS on purpose — no Tailwind bracket utilities) ---- */
  #cc-flip{perspective:1400px}
  #cc-flip-inner{position:relative;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.4,.1,.2,1);cursor:pointer}
  #cc-flip.cc-flipped #cc-flip-inner{transform:rotateY(180deg)}
  #cc-flip .cc-face{display:block;width:100%;height:auto;border-radius:24px;box-shadow:0 18px 40px -18px rgba(124,58,237,.35);backface-visibility:hidden;-webkit-backface-visibility:hidden}
  #cc-flip .cc-face-back{position:absolute;top:0;left:0;width:100%;height:100%;transform:rotateY(180deg);object-fit:cover}
  /* the rebuilt chaos face */
  #cc-chaos-face{position:relative;width:100%;aspect-ratio:968/1530;background:linear-gradient(165deg,#FEF9EF 0%,#FBF1DC 100%);overflow:hidden}
  .cf-pill{position:absolute;left:50%;top:3.4%;transform:translateX(-50%);background:#fff;border:1.5px solid #F2C168;color:#D97A1F;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;border-radius:9999px;padding:5px 14px;white-space:nowrap}
  .cf-h{position:absolute;left:50%;top:7.4%;transform:translateX(-50%);width:80%;margin:0;text-align:center;font-size:17px;line-height:1.35;font-weight:800;color:#1F2937}
  .cf-el{position:absolute}
  .cf-sticky{display:block;background:linear-gradient(180deg,#FBEFAD,#F8E489);border:1px solid rgba(217,164,65,.25);border-radius:8px;box-shadow:0 7px 15px -6px rgba(180,120,40,.4);padding:8px 12px;font-size:16px;line-height:1.12;color:#44506B;width:116px}
  .cf-card{display:flex;align-items:center;gap:8px;background:#fff;border-radius:10px;box-shadow:0 8px 18px -8px rgba(190,120,50,.35);padding:8px 11px;white-space:nowrap}
  .cf-card b{display:block;font-size:11px;font-weight:700;color:#1F2937;line-height:1.25}
  .cf-card i{display:block;font-style:normal;font-size:9.5px;color:#94A3B8;line-height:1.35}
  .cf-card.rose{background:#FDEDED}
  .cf-card.rose i{color:#DC2626;font-weight:600}
  .cf-card.lav{background:#EFECFB}
  .cf-card.mint{background:#E9F7EF}
  .cf-card.peach{background:#FEF3E4}
  .cf-ic{width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex:none;position:relative}
  .cf-badge b{position:absolute;top:-6px;right:-6px;background:#E5484D;color:#fff;font-size:8px;font-weight:800;width:13px;height:13px;border-radius:9999px;display:flex;align-items:center;justify-content:center}
  .cf-lines{display:block;margin-top:5px}
  .cf-lines span{display:block;height:3.5px;border-radius:2px;background:#E5E9F0;margin-top:3.5px;width:64px}
  .cf-lines span:nth-child(2){width:52px}
  .cf-lines span:nth-child(3){width:58px}
  .cf-tabs{display:flex;flex-direction:column;gap:4px}
  .cf-tab{display:flex;align-items:center;gap:6px;background:#fff;border-radius:8px;box-shadow:0 4px 10px -4px rgba(190,120,50,.3);padding:5px 9px;font-size:9.5px;color:#64748B;white-space:nowrap}
  .cf-tab s{margin-left:auto;padding-left:10px;color:#CBD5E1;text-decoration:none;font-size:8px}
  .cf-tab:nth-child(2){margin-left:7px}
  .cf-tab:nth-child(3){margin-left:14px}
  .cf-scrib{display:block;font-size:17.5px;color:#334155;line-height:1.1;text-align:center}
  #cc-flip-btn{display:block;margin:14px auto 0;background:#6D28D9;color:#fff;border:none;border-radius:9999px;padding:11px 22px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 8px 20px -8px rgba(109,40,217,.5)}
  #cc-flip-btn:active{transform:scale(.97)}
  @keyframes ccNudge{0%,100%{transform:rotateY(0)}50%{transform:rotateY(-14deg)}}
  #ua-chaos.ua-in #cc-flip-inner.cc-nudge{animation:ccNudge 1.1s ease .6s 2}
  @media (prefers-reduced-motion: reduce){
    #cc-flip-inner{transition:none}
    #ua-chaos.ua-in #cc-flip-inner.cc-nudge{animation:none}
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("ua-chaos");
    if (!root) return;

    function drawLines() {
      var stage = document.getElementById("cc-stage");
      var svg = document.getElementById("cc-svg");
      var dash = document.getElementById("cc-dash");
      if (!stage || !svg || !dash) return;
      var sr = stage.getBoundingClientRect();
      if (!sr.width) return;
      svg.setAttribute("viewBox", "0 0 " + sr.width + " " + sr.height);
      var dr = dash.getBoundingClientRect();
      var cx = dr.left - sr.left + dr.width / 2;
      var cy = dr.top - sr.top + dr.height / 2;
      var dTop = dr.top - sr.top;
      var dBottom = dr.top - sr.top + dr.height;
      var orbit = window.matchMedia("(min-width: 1280px)").matches;
      var cards = stage.querySelectorAll(".cc-feature");
      var lines = svg.querySelectorAll(".cc-line");
      cards.forEach(function (card, i) {
        var r = card.getBoundingClientRect();
        var line = lines[i];
        if (!line) return;
        var x2 = r.left - sr.left + r.width / 2;
        var y2 = r.top - sr.top + r.height / 2;
        var d;
        if (orbit) {
          // curved line from dashboard center to card center (ends hidden under cards)
          var mx = (cx + x2) / 2, my = (cy + y2) / 2;
          var dx = x2 - cx, dy = y2 - cy;
          var len = Math.sqrt(dx * dx + dy * dy) || 1;
          var bend = 14 * (i % 2 === 0 ? 1 : -1);
          var qx = mx + (-dy / len) * bend;
          var qy = my + (dx / len) * bend;
          d = "M" + cx + " " + cy + " Q " + qx + " " + qy + ", " + x2 + " " + y2;
        } else if (i === 0) {
          // spine fallback: Family Passport down into the dashboard
          var fy = r.top - sr.top + r.height;
          var m = (fy + dTop) / 2;
          d = "M" + x2 + " " + fy + " C " + x2 + " " + m + ", " + cx + " " + m + ", " + cx + " " + dTop;
        } else {
          // spine fallback: elbow from dashboard bottom out to each card
          var inner = x2 < cx ? r.right - sr.left : r.left - sr.left;
          var ey = y2;
          d = "M" + cx + " " + dBottom + " Q " + cx + " " + ey + ", " + inner + " " + ey;
        }
        line.setAttribute("d", d);
      });
    }

    requestAnimationFrame(drawLines);
    window.addEventListener("load", drawLines);
    var rt;
    window.addEventListener("resize", function () { clearTimeout(rt); rt = setTimeout(drawLines, 120); });

    if (!("IntersectionObserver" in window)) { root.classList.add("ua-in"); drawLines(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { root.classList.add("ua-in"); drawLines(); io.disconnect(); } });
    }, { threshold: 0.15 });
    io.observe(root);
  })();
</script>

<script is:inline>
  /* mobile flip card: tap anywhere on the card (or the button) to flip */
  (function () {
    var flip = document.getElementById("cc-flip");
    if (!flip) return;
    var inner = document.getElementById("cc-flip-inner");
    var btn = document.getElementById("cc-flip-btn");
    inner.classList.add("cc-nudge"); /* little "flip me" wiggle on first reveal */
    function toggle() {
      inner.classList.remove("cc-nudge");
      flip.classList.toggle("cc-flipped");
      btn.textContent = flip.classList.contains("cc-flipped")
        ? "↩ Back to today"
        : "✨ With UniqueApex →";
    }
    inner.addEventListener("click", toggle);
    btn.addEventListener("click", toggle);
  })();
</script>