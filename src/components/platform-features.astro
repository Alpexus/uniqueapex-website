---
// =============================================================================
// UniqueApex · Platform Features v3 — bento layout
// Replaces: src/components/platform-features.astro
// v3.0 · 2026-08-02 — bento redesign: 2 feature cards with mini-UI vignettes
// (outreach status list + passport progress) over a 4-card row. All v2.1 copy,
// badges, More/Less expanders, cursor glow and reveal behavior preserved.
// =============================================================================
// @ts-ignore
import { Icon } from "astro-icon/components";

interface Props {
  lang?: "en" | "fr";
}

const { lang = "en" } = Astro.props;

const content = {
  en: {
    heading: "Much more than a",
    headingAccent: "search tool",
    body: "UniqueApex is a long-term support system that grows with your family — from first concern through every stage of your child's development. Here's everything we're building for your family.",
    more: "More",
    less: "Less",
    badges: { beta: "Available in Beta", soon: "Coming Soon" },
    ui: {
      outreach: {
        rows: [
          { name: "Speech-language clinic", label: "Replied", tone: "green" },
          { name: "Occupational therapy", label: "Sent", tone: "violet" },
          { name: "Psychoeducation service", label: "Waitlist", tone: "amber" },
        ],
        foot: "One batch · replies tracked automatically",
      },
      passport: {
        name: "Maya Flores",
        meta: "Age 6 · Autism",
        label: "Passport",
        pct: "93% complete",
        chips: ["Strengths", "Sensory profile", "Care team", "Goals"],
      },
    },
    features: [
      {
        title: "Provider Matching & Outreach",
        description: "Skip the twenty phone calls. You get a curated shortlist — availability, fees, and fit notes — while we contact matched providers for you.",
        detail: "Speech, OT, behavioural and more — matched on fit, not just postal code.",
        icon: "bx:bxs-network-chart",
        status: "beta",
      },
      {
        title: "Family Passport",
        description: "Never re-tell your child's story. One portable profile — history, therapy records, communication profile — travels with them to every provider, school, and transition.",
        detail: "You control what's shared, and everything exports to PDF for any meeting.",
        icon: "bx:bxs-id-card",
        status: "beta",
      },
      {
        title: "Government Funding Navigator",
        description: "Stop leaving money on the table. Every grant, subsidy, and tax credit your family qualifies for — explained in plain language, with direct application links.",
        detail: "Built first for Québec and federal programs, growing as we expand.",
        icon: "bx:bxs-bank",
        status: "beta",
      },
      {
        title: "Expert Workshops & Peer Community",
        description: "You are not alone in this. Live sessions with psychologists and specialists, plus a community of parents who understand — no backstory needed.",
        detail: "Ask questions in a space where nobody needs the backstory explained.",
        icon: "bx:bxs-group",
        status: "beta",
      },
      {
        title: "AI Document Intelligence",
        description: "Reports become answers. Upload any assessment or IEP and get the key findings in plain language — with your child's Passport updated for you.",
        detail: "Findings and recommendations in parent language — you review everything before it's saved.",
        icon: "bx:bxs-file-find",
        status: "soon",
      },
      {
        title: "Transition Alert System",
        description: "Never be caught without a plan. We alert you 60–90 days before a contract ends, a programme closes, or a school year turns over.",
        detail: "The platform watches the calendar so your family doesn't have to.",
        icon: "bx:bxs-bell",
        status: "soon",
      },
    ],
  },
  fr: {
    heading: "Bien plus qu'un",
    headingAccent: "outil de recherche",
    body: "UniqueApex est un système de soutien à long terme qui grandit avec votre famille — de la première préoccupation à chaque étape du développement de votre enfant. Voici tout ce que nous bâtissons pour votre famille.",
    more: "Plus",
    less: "Moins",
    badges: { beta: "Offert en version bêta", soon: "À venir" },
    ui: {
      outreach: {
        rows: [
          { name: "Clinique d'orthophonie", label: "Réponse", tone: "green" },
          { name: "Ergothérapie", label: "Envoyé", tone: "violet" },
          { name: "Psychoéducation", label: "Attente", tone: "amber" },
        ],
        foot: "Un seul envoi · réponses suivies automatiquement",
      },
      passport: {
        name: "Maya Flores",
        meta: "6 ans · Autisme",
        label: "Passeport",
        pct: "complété à 93 %",
        chips: ["Forces", "Profil sensoriel", "Équipe de soins", "Objectifs"],
      },
    },
    features: [
      {
        title: "Jumelage et démarches auprès des professionnels",
        description: "Fini les vingt appels. Vous recevez une liste ciblée — disponibilités, tarifs et compatibilité — pendant que nous contactons les professionnels pour vous.",
        detail: "Orthophonie, ergothérapie, comportement et plus — un jumelage basé sur la compatibilité, pas seulement le code postal.",
        icon: "bx:bxs-network-chart",
        status: "beta",
      },
      {
        title: "Passeport familial",
        description: "Ne racontez plus jamais l'histoire de votre enfant. Un profil portable — historique, dossiers, profil de communication — le suit chez chaque professionnel, école et transition.",
        detail: "Vous contrôlez ce qui est partagé, et tout s'exporte en PDF pour n'importe quelle rencontre.",
