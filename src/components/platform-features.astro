const bigFeatures = content.features.slice(0, 2);
const smallFeatures = content.features.slice(2);

const pillTones: Record<string, string> = {
  green: "bg-emerald-50 text-emerald-700",
  violet: "bg-violet-50 text-violet-700",
  amber: "bg-amber-50 text-amber-700",
};
---

<section class="py-16 my-4" id="pf2">
  <div class="text-center max-w-3xl mx-auto">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
      {content.heading} <span class="text-violet-600">{content.headingAccent}</span>
    </h2>
    <p class="text-lg mt-4 text-slate-600 mx-auto">
      {content.body}
    </p>
  </div>

  <div id="pf2-grid" class="mt-14">
    <!-- Row 1 — two feature cards with mini-UI vignettes -->
    <div class="grid lg:grid-cols-2 gap-5">
      {
        bigFeatures.map((item, i) => (
          <button type="button" class={`pf2-card group flex flex-col text-left p-6 sm:p-7 rounded-3xl border border-slate-200 cursor-pointer ${i === 1 ? "bg-gradient-to-b from-violet-50/80 via-white to-white" : "bg-white"}`} aria-expanded="false">
            <div class="flex items-center justify-between mb-4 relative">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-500 to-violet-700 flex items-center justify-center shadow-md shadow-violet-200 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
                <Icon class="text-white w-6 h-6" name={item.icon} />
              </div>
              <span class={`text-xs font-semibold px-3 py-1 rounded-full ${item.status === "beta" ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : "bg-slate-100 text-slate-500 border border-slate-200"}`}>
                {content.badges[item.status as keyof typeof content.badges]}
              </span>
            </div>
            <h3 class="font-semibold text-xl text-slate-800 group-hover:text-violet-700 transition-colors relative">{item.title}</h3>
            <p class="text-slate-500 mt-2 leading-relaxed text-[15px] relative">{item.description}</p>

            {i === 0 ? (
              <div class="mt-5 bg-white border border-slate-200 rounded-2xl p-4 shadow-[0_12px_30px_rgba(84,51,168,0.08)] relative" aria-hidden="true">
                {content.ui.outreach.rows.map((row) => (
                  <p class="flex items-center justify-between gap-2 py-2 border-b border-slate-100 last:border-0 text-[14px] text-slate-600 m-0">
                    <span>{row.name}</span>
                    <span class={`text-xs font-bold rounded-full px-2.5 py-0.5 ${pillTones[row.tone]}`}>{row.label}</span>
                  </p>
                ))}
                <p class="text-[13px] font-semibold text-violet-700 mt-2 m-0">{content.ui.outreach.foot}</p>
              </div>
            ) : (
              <div class="mt-5 bg-white border border-slate-200 rounded-2xl p-4 shadow-[0_12px_30px_rgba(84,51,168,0.08)] relative" aria-hidden="true">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-full bg-gradient-to-br from-violet-600 to-violet-400 text-white font-bold flex items-center justify-center">M</span>
                  <span>
                    <span class="block font-semibold text-slate-800 text-[15px] leading-tight">{content.ui.passport.name}</span>
                    <span class="block text-xs text-slate-400">{content.ui.passport.meta}</span>
                  </span>
                </div>
                <div class="h-2 rounded-full bg-violet-100 mt-3 overflow-hidden">
                  <div class="h-full rounded-full bg-gradient-to-r from-violet-600 to-violet-400" style="width:93%"></div>
                </div>
                <p class="flex justify-between text-xs text-slate-400 mt-1 m-0"><span>{content.ui.passport.label}</span><span>{content.ui.passport.pct}</span></p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {content.ui.passport.chips.map((c) => (
                    <span class="text-xs font-medium text-slate-600 bg-slate-50 border border-slate-200 rounded-full px-2.5 py-0.5">{c}</span>
                  ))}
                </div>
              </div>
            )}

            <div class="pf2-more relative">
              <p class="text-[14.5px] leading-relaxed text-violet-800 bg-violet-50 border border-violet-100 rounded-xl px-3.5 py-2.5 m-0">{item.detail}</p>
            </div>
            <span class="pf2-toggle mt-auto pt-4 inline-flex items-center gap-1 text-xs font-bold text-violet-600 uppercase tracking-wide relative">
              <span class="pf2-toggle-txt">{content.more}</span>
              <svg class="pf2-chev transition-transform duration-200" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </button>
        ))
      }
    </div>

    <!-- Row 2 — four compact cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-5">
      {
        smallFeatures.map((item) => (
          <button type="button" class="pf2-card group flex flex-col text-left p-5 rounded-3xl border border-slate-200 bg-white cursor-pointer" aria-expanded="false">
            <div class="flex items-center justify-between mb-4 gap-2 relative">
              <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-violet-500 to-violet-700 flex items-center justify-center shadow-md shadow-violet-200 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
                <Icon class="text-white w-5 h-5" name={item.icon} />
              </div>
              <span class={`text-[11px] font-semibold px-2.5 py-1 rounded-full text-right ${item.status === "beta" ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : "bg-slate-100 text-slate-500 border border-slate-200"}`}>
                {content.badges[item.status as keyof typeof content.badges]}
              </span>
            </div>
            <h3 class="font-semibold text-base text-slate-800 group-hover:text-violet-700 transition-colors relative">{item.title}</h3>
            <p class="text-slate-500 mt-2 leading-relaxed text-[14px] relative">{item.description}</p>
            <div class="pf2-more relative">
              <p class="text-[13.5px] leading-relaxed text-violet-800 bg-violet-50 border border-violet-100 rounded-xl px-3 py-2 m-0">{item.detail}</p>
            </div>
            <span class="pf2-toggle mt-auto pt-4 inline-flex items-center gap-1 text-xs font-bold text-violet-600 uppercase tracking-wide relative">
              <span class="pf2-toggle-txt">{content.more}</span>
              <svg class="pf2-chev transition-transform duration-200" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  #pf2 .pf2-card{position:relative;overflow:hidden;opacity:0;transition:transform .25s ease,border-color .2s ease,box-shadow .25s ease}
  #pf2 .pf2-card.pf2-in{opacity:1;animation:pf2Rise .65s cubic-bezier(.22,.9,.36,1) backwards}
  @keyframes pf2Rise{from{opacity:0;transform:translateY(26px) scale(.98)}to{opacity:1;transform:none}}
  #pf2 .pf2-card.pf2-in:hover{transform:translateY(-4px);border-color:#c4b5fd;box-shadow:0 12px 32px -12px rgba(124,58,237,.25)}
  #pf2 .pf2-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(124,58,237,.10),transparent 65%);opacity:0;transition:opacity .25s ease;pointer-events:none}
  #pf2 .pf2-card:hover::before{opacity:1}
  #pf2 .pf2-more{max-height:0;overflow:hidden;transition:max-height .3s ease,margin-top .3s ease;margin-top:0}
  #pf2 .pf2-card.pf2-open .pf2-more{max-height:220px;margin-top:10px}
  #pf2 .pf2-card.pf2-open .pf2-chev{transform:rotate(180deg)}
  @media (prefers-reduced-motion: reduce){
    #pf2 .pf2-card{opacity:1;transform:none;transition:border-color .2s ease}
    #pf2 .pf2-card.pf2-in:hover{transform:none}
    #pf2 .pf2-card::before{display:none}
    #pf2 .pf2-more{transition:none}
  }
</style>

<script is:inline>
  (function () {
    var grid = document.getElementById("pf2-grid");
    if (!grid) return;
    var cards = grid.querySelectorAll(".pf2-card");

    cards.forEach(function (card) {
      card.addEventListener("mousemove", function (ev) {
        var r = card.getBoundingClientRect();
        card.style.setProperty("--mx", (ev.clientX - r.left) + "px");
        card.style.setProperty("--my", (ev.clientY - r.top) + "px");
      });
      card.addEventListener("click", function () {
        var open = card.classList.toggle("pf2-open");
        card.setAttribute("aria-expanded", open ? "true" : "false");
        var txt = card.querySelector(".pf2-toggle-txt");
        if (txt) txt.textContent = open ? txt.getAttribute("data-less") : txt.getAttribute("data-more");
      });
      var txt = card.querySelector(".pf2-toggle-txt");
      if (txt) { txt.setAttribute("data-more", txt.textContent.trim()); }
    });

    var lessLabels = { More: "Less", Plus: "Moins" };
    cards.forEach(function (card) {
      var txt = card.querySelector(".pf2-toggle-txt");
      if (txt) txt.setAttribute("data-less", lessLabels[txt.getAttribute("data-more")] || "Less");
    });

    /* each card reveals on ITS OWN scroll arrival (box by box), with a tiny
       stagger inside a desktop row so side-by-side cards don't pop as one */
    if (!("IntersectionObserver" in window)) {
      cards.forEach(function (c) { c.classList.add("pf2-in"); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var c = e.target;
        io.unobserve(c);
        var i = Array.prototype.indexOf.call(cards, c);
        setTimeout(function () { c.classList.add("pf2-in"); }, (i % 3) * 90);
      });
    }, { threshold: 0.15, rootMargin: "600% 0px -8% 0px" }); /* huge top margin: anything scrolled PAST counts as seen — no card can stay invisible after a fast scroll */
    cards.forEach(function (c) { io.observe(c); });
  })();
</script>
