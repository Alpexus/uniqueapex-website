---
// =============================================================================
// UniqueApex · Passport Flow — "tell it once, it travels with them"
// Save as: src/components/passport-flow.astro
// Use in a page:  <PassportFlow lang="en" />   (or lang="fr")
// v3 · 2026-07-26 — the illustrated phone mockup (EN/FR renders) replaces the
//                   interactive diagram at every screen size. The old diagram
//                   markup/CSS/JS lives in git history; unused t.* keys
//                   (passport/child/rows/spokes/bodyAfter) kept as copy reference.
// =============================================================================
const { lang = "en" } = Astro.props;

const t = {
  en: {
    label: "The Family Passport",
    heading: "Tell your child's story once.",
    headingAccent: "It travels with them.",
    body: "Answer a few gentle questions — once. That becomes your child's Family Passport, and the Passport builds everything else for you, automatically.",
    bodyAfter: "No repeating forms. No re-telling your story. It travels with your child everywhere — so you never start from zero again.",
    imgAlt: "UniqueApex app preview on a phone: add your child, fill out the Family Passport once, and watch their support wheel come to life.",
    passport: "Family Passport",
    child: "Maya · Age 7",
    rows: ["Full history", "Strengths & needs", "Reports & documents"],
    spokes: [
      { title: "Therapists & clinics", text: "The full picture, ready before the first session" },
      { title: "School & daycare", text: "Strengths and strategies from day one" },
      { title: "Funding programs", text: "The details every application asks for" },
      { title: "Every new provider", text: "No re-explaining. Ever." },
    ],
  },
  fr: {
    label: "Le Passeport familial",
    heading: "Racontez l'histoire de votre enfant une seule fois.",
    headingAccent: "Elle le suit partout.",
    body: "Répondez à quelques questions simples — une seule fois. Elles deviennent le Passeport familial de votre enfant, et le Passeport construit tout le reste pour vous, automatiquement.",
    bodyAfter: "Aucun formulaire à répéter. Aucune histoire à raconter de nouveau. Il suit votre enfant partout — pour ne plus jamais repartir de zéro.",
    imgAlt: "Aperçu de l'application UniqueApex sur un téléphone : ajoutez votre enfant, remplissez le Passeport familial une seule fois, et voyez sa roue de soutien prendre vie.",
    passport: "Passeport familial",
    child: "Maya · 7 ans",
    rows: ["Historique complet", "Forces et besoins", "Rapports et documents"],
    spokes: [
      { title: "Thérapeutes et cliniques", text: "Le portrait complet, prêt avant la première séance" },
      { title: "École et garderie", text: "Forces et stratégies dès le premier jour" },
      { title: "Programmes de financement", text: "Les détails que chaque demande exige" },
      { title: "Chaque nouvel intervenant", text: "Plus jamais besoin de tout réexpliquer." },
    ],
  },
}[lang] || {};
---

<section class="py-16 my-4" id="ua-passport">
  <div class="text-center max-w-3xl mx-auto mb-14">
    <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.label}</p>
    <h2 class="text-3xl md:text-4xl font-bold mt-3 text-slate-800 leading-tight">
      {t.heading} <span class="text-violet-700">{t.headingAccent}</span>
    </h2>
    <p class="text-slate-500 mt-6 text-lg">{t.body}</p>
  </div>

  <!-- The illustrated phone mockup, shown at every screen size (the interactive
       diagram it replaced lives in git history). EN/FR renders swap by lang. -->
  <div class="max-w-sm md:max-w-md mx-auto px-2">
    <img
      src={lang === "fr" ? "/passport-phone-fr.webp" : "/passport-phone-en.webp"}
      alt={t.imgAlt}
      width="1200" height="1800"
      class="w-full h-auto rounded-3xl shadow-xl shadow-violet-200/60"
      loading="lazy"
    />
  </div>

</section>

