---
// =============================================================================
// UniqueApex · About — NAME-V9 (full regeneration, single source of truth)
// Contains: story hero · founder companion letter (script signature, two-tone
// quote, no chip/bar) · vision · mission · click-to-reveal name images (no
// tagline) · blob value cards · balanced spacing.
// REPLACE THE WHOLE FILE. Do not edit in the preview pane.
// =============================================================================
// @ts-ignore
import { Icon } from "astro-icon/components";

const { lang = "en" } = Astro.props;

const t = {
  en: {
    story: {
      label: "Our Story",
      title1: "Built by a parent,",
      title2: "for every family",
      paras: [
        "Families are left to navigate fragmented systems alone — becoming researchers, schedulers, advocates, and coordinators on top of being caregivers.",
        "Behind every appointment, assessment, and waitlist is a family trying to build the best possible path forward for their child.",
        "UniqueApex was born from lived experience and a simple belief: families deserve better infrastructure, not just better intentions.",
      ],
      imgAlt: "Family climbing illustration",
    },
    founder: {
      label: "A Message From Our Founder",
      quote1: "\u201CBehind every waitlist is a family that",
      quote2: "needed help yesterday.\u201D",
      paras: [
        "UniqueApex was born from my own journey as a parent. I know what it's like to live inside a spreadsheet of clinic names — the voicemails, the callbacks, the same forms, telling your child's story from zero to every new stranger.",
        "So I set out to build the companion I wished we'd had: one place that carries your child's whole story, reaches out to the right providers, keeps every document and waitlist in view, and guides you through funding, school, and every transition — from the very first concern all the way to adulthood.",
        "Because no family should ever navigate this alone. Whatever stage you're at, we walk it with you.",
      ],
      tagline: "Every child's journey is different. Every family deserves better support.",
      name: "Pelin İpek Temurcan",
      role: "Founder & CEO",
      imgAlt: "Pelin İpek Temurcan",
    },
    vision: {
      badge: "Our Vision",
      title1: "A world where no family navigates",
      title2: "alone",
      body: "We envision a future where every family of a neurodivergent child has access to a connected, coordinated support system — regardless of language, location, or how overwhelmed they feel.",
      imgAlt: "Vision illustration",
    },
    mission: {
      badge: "Our Mission",
      title1: "Coordination infrastructure,",
      title2: "not just a directory",
      paras: [
        "UniqueApex is a support ecosystem designed to help families navigate complex care journeys with greater clarity and better coordination.",
        "We are starting with the most urgent pain point — connecting families with the right providers. Our long-term vision is to build a fully connected, accessible infrastructure for neurodivergent families everywhere.",
      ],
      imgAlt: "Mission illustration",
    },
    name: {
      label: "Behind The Name",
      title1: "What does",
      title2: "UniqueApex",
      title3: "mean?",
      unique: { title: "Unique", body: "Every neurodivergent child is unique — with their own strengths, their own timeline, and their own path. There is no one-size-fits-all support system." },
      apex: { title: "Apex", body: "Every family is climbing toward its own version of progress, growth, and wellbeing. UniqueApex exists to make that climb less isolating." },
    },
    values: {
      label: "Our Values",
      title: "What we stand for",
      items: [
        { icon: "bx:bxs-heart", title: "Empathy", body: "Every decision we make is grounded in the real experience of parents navigating an overwhelming system." },
        { icon: "bx:bxs-file-find", title: "Clarity", body: "We make complex systems simple so families can focus on their child — not on paperwork." },
        { icon: "bx:bxs-user-check", title: "Access", body: "Every child deserves support regardless of language, location, or how overwhelmed their parents feel." },
        { icon: "bx:bxs-group", title: "Community", body: "No family navigates alone. UniqueApex connects families with each other, with experts, and with the right providers." },
      ],
    },
  },
  fr: {
    story: {
      label: "Notre histoire",
      title1: "Créé par un parent,",
      title2: "pour chaque famille",
      paras: [
        "Les familles sont laissées à elles-mêmes pour naviguer des systèmes fragmentés — devenant chercheuses, planificatrices, plaideuses et coordinatrices en plus d'être aidantes.",
        "Derrière chaque rendez-vous, évaluation et liste d'attente, il y a une famille qui essaie de construire le meilleur chemin possible pour son enfant.",
        "UniqueApex est né d'une expérience vécue et d'une conviction simple : les familles méritent une meilleure infrastructure, pas seulement de meilleures intentions.",
      ],
      imgAlt: "Illustration d'une famille qui grimpe",
    },
    founder: {
      label: "Un message de notre fondatrice",
      quote1: "« Derrière chaque liste d'attente, il y a une famille qui avait",
      quote2: "besoin d'aide hier. »",
      paras: [
        "UniqueApex est né de mon propre parcours en tant que parent. Je sais ce que c'est que de vivre dans un tableur de noms de cliniques — les boîtes vocales, les rappels, les mêmes formulaires, raconter l'histoire de son enfant depuis le début à chaque nouvel inconnu.",
        "Alors j'ai voulu bâtir le compagnon que j'aurais aimé avoir : un seul endroit qui porte toute l'histoire de votre enfant, contacte les bons professionnels, garde chaque document et chaque liste d'attente en vue, et vous guide à travers le financement, l'école et chaque transition — des premières inquiétudes jusqu'à l'âge adulte.",
        "Parce qu'aucune famille ne devrait traverser ce parcours seule. Peu importe où vous en êtes, on marche avec vous.",
      ],
      tagline: "Le parcours de chaque enfant est différent. Chaque famille mérite un meilleur soutien.",
      name: "Pelin İpek Temurcan",
      role: "Fondatrice et PDG",
      imgAlt: "Pelin İpek Temurcan",
    },
    vision: {
      badge: "Notre vision",
      title1: "Un monde où aucune famille ne navigue",
      title2: "seule",
      body: "Nous envisageons un avenir où chaque famille d'un enfant neurodivergent a accès à un système de soutien connecté et coordonné — peu importe la langue, la localisation ou le niveau de stress ressenti.",
      imgAlt: "Illustration de la vision",
    },
    mission: {
      badge: "Notre mission",
      title1: "Une infrastructure de coordination,",
      title2: "pas juste un répertoire",
      paras: [
        "UniqueApex est un écosystème de soutien conçu pour aider les familles à naviguer des parcours de soins complexes avec plus de clarté et une meilleure coordination.",
        "Nous commençons par le besoin le plus urgent — connecter les familles aux bons professionnels. Notre vision à long terme est de bâtir une infrastructure complète, connectée et accessible pour les familles neurodivergentes partout.",
      ],
      imgAlt: "Illustration de la mission",
    },
    name: {
      label: "Derrière le nom",
      title1: "Que signifie",
      title2: "UniqueApex",
      title3: "?",
      unique: { title: "Unique", body: "Chaque enfant neurodivergent est unique — avec ses propres forces, son propre rythme et son propre chemin. Il n'existe pas de solution universelle." },
      apex: { title: "Apex", body: "Chaque famille grimpe vers sa propre version du progrès, de la croissance et du bien-être. UniqueApex existe pour rendre cette ascension moins isolante." },
    },
    values: {
      label: "Nos valeurs",
      title: "Ce qui nous guide",
      items: [
        { icon: "bx:bxs-heart", title: "Empathie", body: "Chaque décision que nous prenons est ancrée dans l'expérience réelle des parents qui naviguent un système complexe." },
        { icon: "bx:bxs-file-find", title: "Clarté", body: "Nous simplifions les systèmes complexes pour que les familles puissent se concentrer sur leur enfant — pas sur la paperasse." },
        { icon: "bx:bxs-user-check", title: "Accessibilité", body: "Chaque enfant mérite du soutien, peu importe la langue, la localisation ou le niveau de stress de ses parents." },
        { icon: "bx:bxs-group", title: "Communauté", body: "Aucune famille ne navigue seule. UniqueApex connecte les familles entre elles, avec des experts et les bons professionnels." },
      ],
    },
  },
}[lang];
---

<div id="ua-about">
  <!-- signature font — loaded as a <link> (NOT a CSS @import: Astro bundles styles
       and a mid-file @import gets silently ignored by browsers, breaking the font) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" />

  <!-- Hero + Brand Story (text-only — the climbing illustration was retired) -->
  <div class="ab-hero max-w-3xl mx-auto text-center mt-10 md:mt-16 mb-16 md:mb-28 space-y-5 md:space-y-6">
    <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.story.label}</p>
    <h1 class="text-[32px] leading-[1.15] md:text-5xl font-bold text-slate-800 md:leading-tight">
      {t.story.title1} <span class="text-violet-700">{t.story.title2}</span>
    </h1>
    {t.story.paras.map((p) => (
      <p class="text-slate-600 leading-relaxed text-base md:text-lg">{p}</p>
    ))}
  </div>

  <!-- Founder -->
  <div class="ab-rev relative bg-violet-50/60 border border-violet-100 rounded-3xl p-6 sm:p-10 md:p-16 mb-16 md:mb-32 overflow-hidden">
    <div class="relative grid md:grid-cols-3 gap-8 md:gap-12 items-center">
      <div class="flex flex-col items-center text-center">
        <div class="relative w-40 h-40 sm:w-56 sm:h-56">
          <div class="absolute -inset-3 bg-violet-100" style="border-radius:56% 44% 48% 52% / 46% 54% 44% 56%"></div>
          <img src="/headshot.jpeg" alt={t.founder.imgAlt} class="relative w-40 h-40 sm:w-56 sm:h-56 rounded-full object-cover shadow-xl ring-4 ring-white" />
        </div>
        <h3 class="font-bold text-xl mt-5 text-slate-800">{t.founder.name}</h3>
        <p class="text-violet-700 font-medium m-0">{t.founder.role}</p>
      </div>
      <div class="md:col-span-2">
        <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.founder.label}</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mt-4 text-slate-800 leading-tight tracking-tight">
          {t.founder.quote1} <span class="text-violet-700">{t.founder.quote2}</span>
        </h2>
        {t.founder.paras.map((p, i) => (
          <p class={`text-slate-500 leading-relaxed text-base sm:text-lg ${i === 0 ? "mt-6" : "mt-4"}`}>{p}</p>
        ))}
        <p class="text-violet-700 mt-6 text-base sm:text-lg font-medium italic">{t.founder.tagline}</p>
        <p class="ab-sign m-0 mt-5" style="transform:rotate(-1.5deg)">Pelin İpek Temurcan</p>
      </div>
    </div>
  </div>

  <!-- Vision + Mission — one section, designed around a single illustration -->
  <div class="ab-rev relative overflow-hidden bg-gradient-to-b from-violet-50/70 to-white border border-violet-100 rounded-3xl p-6 sm:p-10 md:p-14 mb-16 md:mb-32">
    <div class="grid md:grid-cols-2 gap-8 md:gap-14 items-center">
      <div class="flex items-center justify-center">
        <img src="/mission-illustration.png" alt={t.mission.imgAlt} class="w-full max-w-[300px] sm:max-w-[400px] md:max-w-[460px]" />
      </div>
      <div>
        <div>
          <span class="inline-block bg-violet-100 text-violet-700 text-sm font-semibold px-4 py-1 rounded-full mb-4 sm:mb-5">{t.vision.badge}</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 leading-tight mb-3 sm:mb-4">
            {t.vision.title1} <span class="text-violet-700">{t.vision.title2}</span>
          </h2>
          <p class="text-slate-500 leading-relaxed text-base sm:text-lg m-0">{t.vision.body}</p>
        </div>
        <div class="border-t border-violet-100 mt-7 sm:mt-9 pt-7 sm:pt-9">
          <span class="inline-block bg-violet-100 text-violet-700 text-sm font-semibold px-4 py-1 rounded-full mb-4 sm:mb-5">{t.mission.badge}</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 leading-tight mb-3 sm:mb-4">
            {t.mission.title1} <span class="text-violet-700">{t.mission.title2}</span>
          </h2>
          {t.mission.paras.map((p, i) => (
            <p class={`text-slate-500 leading-relaxed text-base sm:text-lg ${i === 0 ? "m-0" : "mt-4 mb-0"}`}>{p}</p>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Name meaning — both halves always visible, styled like the brand wordmark -->
  <div class="ab-rev mb-16 md:mb-32">
    <div class="max-w-3xl mx-auto text-center mb-8 md:mb-12">
      <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide mb-4">{t.name.label}</p>
      <h2 class="text-[28px] leading-tight md:text-4xl font-bold text-slate-800 md:leading-tight">
        {t.name.title1} <span class="whitespace-nowrap">Unique<span class="text-violet-700">Apex</span></span> {t.name.title3}
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-4 sm:gap-6 max-w-4xl mx-auto">
      <div class="nm-card relative bg-white border border-violet-100 rounded-3xl p-6 sm:p-8 text-center shadow-sm">
        <img src="/icon-unique.png" alt="" class="w-28 h-28 sm:w-36 sm:h-36 mx-auto" />
        <span class="block text-2xl font-bold text-slate-800 mt-3 sm:mt-4">{t.name.unique.title}</span>
        <span class="block text-slate-500 text-[15px] sm:text-base leading-relaxed mt-2.5 max-w-sm mx-auto">{t.name.unique.body}</span>
      </div>
      <div class="nm-card relative bg-white border border-violet-100 rounded-3xl p-6 sm:p-8 text-center shadow-sm">
        <img src="/icon-apex.png" alt="" class="w-28 h-28 sm:w-36 sm:h-36 mx-auto" />
        <span class="block text-2xl font-bold text-violet-700 mt-3 sm:mt-4">{t.name.apex.title}</span>
        <span class="block text-slate-500 text-[15px] sm:text-base leading-relaxed mt-2.5 max-w-sm mx-auto">{t.name.apex.body}</span>
      </div>
    </div>
  </div>

  <!-- Values -->
  <div class="ab-rev ab-values mb-16 md:mb-28">
    <div class="text-center mb-8 md:mb-12">
      <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.values.label}</p>
      <h2 class="text-[28px] md:text-4xl font-bold mt-3 text-slate-800">{t.values.title}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
      {t.values.items.map((item, vi) => (
        <div class="ab-card relative bg-white border border-violet-100 rounded-3xl px-5 py-7 text-center shadow-sm">
          <div class="relative w-24 h-24 mx-auto mb-5">
            <div class="ab-blob absolute inset-1.5" style={["border-radius:46% 54% 58% 42% / 52% 44% 56% 48%","border-radius:58% 42% 46% 54% / 44% 56% 48% 52%","border-radius:52% 48% 42% 58% / 56% 46% 54% 44%","border-radius:44% 56% 54% 46% / 48% 58% 42% 56%"][vi]}></div>
            {vi === 0 ? (
              <svg class="ab-acc absolute -top-1 right-0 w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5" stroke-linecap="round"><path d="M16 6l3-3M18 11h4M12 5V1"/></svg>
            ) : (
              <svg class="ab-acc ab-spark absolute -top-1 -right-1 w-4 h-4" viewBox="0 0 24 24"><path d="M12 2l2.2 6.6L21 12l-6.8 3.4L12 22l-2.2-6.6L3 12l6.8-3.4z" fill="#c4b5fd"/></svg>
            )}
            <svg class="ab-acc ab-spark ab-spark2 absolute bottom-0 -left-1 w-3 h-3" viewBox="0 0 24 24"><path d="M12 2l2.2 6.6L21 12l-6.8 3.4L12 22l-2.2-6.6L3 12l6.8-3.4z" fill="#ddd6fe"/></svg>
            <span class="ab-ic absolute inset-0 flex items-center justify-center text-violet-600">
              <Icon class="w-10 h-10" name={item.icon} />
            </span>
          </div>
          <span class="block text-lg font-bold text-slate-800 leading-snug">{item.title}</span>
          <span class="block text-sm text-slate-500 leading-relaxed mt-2">{item.body}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* the signature: black ink, script — the font itself is loaded via <link> above */
  #ua-about .ab-sign{font-family:'Great Vibes','Segoe Script','Brush Script MT',cursive;font-size:clamp(2rem,7vw,2.6rem);line-height:1.2;color:#111827}
  #ua-about .ab-hero{animation:abUp .7s ease both}
  @keyframes abUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  #ua-about .ab-rev{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
  #ua-about .ab-rev.ab-in{opacity:1;transform:none}
  #ua-about .ab-card{opacity:0;transition:transform .25s ease,box-shadow .25s ease,border-color .2s ease}
  #ua-about .ab-values.ab-in .ab-card{animation:abCardIn .5s ease both}
  #ua-about .ab-values.ab-in .ab-card:nth-child(1){animation-delay:.05s}
  #ua-about .ab-values.ab-in .ab-card:nth-child(2){animation-delay:.15s}
  #ua-about .ab-values.ab-in .ab-card:nth-child(3){animation-delay:.25s}
  #ua-about .ab-values.ab-in .ab-card:nth-child(4){animation-delay:.35s}
  @keyframes abCardIn{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:none}}
  #ua-about .ab-card:hover{transform:translateY(-6px);border-color:#c4b5fd;box-shadow:0 16px 32px -14px rgba(124,58,237,.28)}
  #ua-about .ab-card:active{transform:translateY(-2px) scale(.99)}
  #ua-about .ab-blob{background:#EDE9FE;transition:transform .5s cubic-bezier(.34,1.5,.64,1)}
  #ua-about .ab-card:hover .ab-blob{transform:scale(1.12) rotate(9deg)}
  #ua-about .ab-ic{transition:transform .35s cubic-bezier(.34,1.6,.64,1)}
  #ua-about .ab-card:hover .ab-ic{transform:scale(1.14) rotate(-5deg)}
  #ua-about .ab-acc{opacity:.85}
  #ua-about .ab-card:hover .ab-spark{animation:abTwinkle 1s ease infinite}
  #ua-about .ab-card:hover .ab-spark2{animation-delay:.3s}
  @keyframes abTwinkle{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.35);opacity:1}}
  #ua-about .nm-card{transition:transform .25s ease,box-shadow .25s ease,border-color .2s ease}
  #ua-about .nm-card:hover{transform:translateY(-6px);border-color:#c4b5fd;box-shadow:0 16px 32px -14px rgba(124,58,237,.28)}
  @media (prefers-reduced-motion: reduce){
    #ua-about .ab-hero{animation:none}
    #ua-about .ab-rev{opacity:1;transform:none;transition:none}
    #ua-about .ab-card{opacity:1;animation:none;transition:none}
    #ua-about .ab-card:hover,#ua-about .ab-card:hover .ab-ic,#ua-about .ab-card:hover .ab-blob{transform:none}
    #ua-about .ab-spark,#ua-about .ab-card:hover .ab-spark,#ua-about .ab-card:hover .ab-spark2{animation:none}
    #ua-about .nm-card{transition:none}
    #ua-about .nm-card:hover{transform:none}
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("ua-about");
    if (!root) return;

    // ---- Scroll reveals ----
    var els = root.querySelectorAll(".ab-rev");
    if (!("IntersectionObserver" in window)) {
      els.forEach(function (e) { e.classList.add("ab-in"); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("ab-in"); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: "600% 0px -8% 0px" }); /* top margin: fast-scroll safety net */
    els.forEach(function (e) { io.observe(e); });
  })();
</script>