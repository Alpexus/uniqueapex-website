---

<div id="ua-about">
  <!-- signature font — loaded as a <link> (NOT a CSS @import: Astro bundles styles
       and a mid-file @import gets silently ignored by browsers, breaking the font) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allison&display=swap" />

  <!-- Hero + Brand Story (text-only — the climbing illustration was retired) -->
  <div class="ab-hero max-w-3xl mx-auto text-center mt-10 md:mt-16 mb-16 md:mb-28 space-y-5 md:space-y-6">
    <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.story.label}</p>
    <h1 class="text-[32px] leading-[1.15] md:text-5xl font-bold text-slate-800 md:leading-tight">
      {t.story.title1} <span class="text-violet-700">{t.story.title2}</span>
    </h1>
    {t.story.paras.map((p) => (
      <p class="text-slate-600 leading-relaxed text-base md:text-lg">{p}</p>
    ))}
  </div>

  <!-- Founder -->
  <div class="ab-rev relative bg-violet-50/60 border border-violet-100 rounded-3xl p-6 sm:p-10 md:p-16 mb-16 md:mb-32 overflow-hidden">
    <!-- section label sits at the very top of the card, above the photo -->
    <p class="relative text-sm font-semibold text-violet-700 uppercase tracking-wide text-center mt-0 mb-8 md:mb-12">{t.founder.label}</p>
    <div class="relative grid md:grid-cols-3 gap-8 md:gap-12 items-center">
      <div class="flex flex-col items-center text-center">
        <div class="relative w-40 h-40 sm:w-56 sm:h-56">
          <div class="absolute -inset-3 bg-violet-100" style="border-radius:56% 44% 48% 52% / 46% 54% 44% 56%"></div>
          <img src="/headshot.jpeg" alt={t.founder.imgAlt} class="relative w-40 h-40 sm:w-56 sm:h-56 rounded-full object-cover shadow-xl ring-4 ring-white" />
        </div>
        <h3 class="font-bold text-xl mt-5 text-slate-800">{t.founder.name}</h3>
        <p class="text-violet-700 font-medium m-0">{t.founder.role}</p>
      </div>
      <div class="md:col-span-2">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mt-0 text-slate-800 leading-tight tracking-tight">
          {t.founder.quote1} <span class="text-violet-700">{t.founder.quote2}</span>
        </h2>
        {t.founder.paras.map((p, i) => (
          <p class={`text-slate-500 leading-relaxed text-base sm:text-lg ${i === 0 ? "mt-6" : "mt-4"}`}>{p}</p>
        ))}
        <p class="text-violet-700 mt-6 text-base sm:text-lg font-medium italic">{t.founder.tagline}</p>
        <p class="ab-sign m-0 mt-5" style="transform:rotate(-1.5deg)">Pelin İpek Temurcan</p>
      </div>
    </div>
  </div>

  <!-- Mission + Vision — one section, with its own header like the others -->
  <div class="ab-rev mb-16 md:mb-32">
    <div class="max-w-3xl mx-auto text-center mb-8 md:mb-12">
      <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide mb-4">{t.mv.label}</p>
      <h2 class="text-[28px] leading-tight md:text-4xl font-bold text-slate-800 md:leading-tight">
        {t.mv.title1} <span class="text-violet-700">{t.mv.title2}</span>
      </h2>
    </div>
    <div class="relative overflow-hidden bg-gradient-to-b from-violet-50/70 to-white border border-violet-100 rounded-3xl p-6 sm:p-10 md:p-14">
      <div class="grid md:grid-cols-2 gap-8 md:gap-14 items-center">
        <div class="flex items-center justify-center">
          <img src="/vision-illustration.png" alt={t.vision.imgAlt} class="w-full max-w-[300px] sm:max-w-[400px] md:max-w-[460px]" />
        </div>
        <div>
          <div>
            <span class="inline-block bg-violet-100 text-violet-700 text-sm font-semibold px-4 py-1 rounded-full mb-4 sm:mb-5">{t.mission.badge}</span>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-800 leading-tight mb-3 sm:mb-4">
              {t.mission.title1} <span class="text-violet-700">{t.mission.title2}</span>
            </h3>
            {t.mission.paras.map((p, i) => (
              <p class={`text-slate-500 leading-relaxed text-base sm:text-lg ${i === 0 ? "m-0" : "mt-4 mb-0"}`}>{p}</p>
            ))}
          </div>
          <div class="border-t border-violet-100 mt-7 sm:mt-9 pt-7 sm:pt-9">
            <span class="inline-block bg-violet-100 text-violet-700 text-sm font-semibold px-4 py-1 rounded-full mb-4 sm:mb-5">{t.vision.badge}</span>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-800 leading-tight mb-3 sm:mb-4">
              {t.vision.title1} <span class="text-violet-700">{t.vision.title2}</span>
            </h3>
            <p class="text-slate-500 leading-relaxed text-base sm:text-lg m-0">{t.vision.body}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Name meaning — both halves always visible, styled like the brand wordmark -->
  <div class="ab-rev mb-16 md:mb-32">
    <div class="max-w-3xl mx-auto text-center mb-8 md:mb-12">
      <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide mb-4">{t.name.label}</p>
      <h2 class="text-[28px] leading-tight md:text-4xl font-bold text-slate-800 md:leading-tight">
        {t.name.title1} <span class="whitespace-nowrap">Unique<span class="text-violet-700">Apex</span></span> {t.name.title3}
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-4 sm:gap-6 max-w-4xl mx-auto">
      {[
        { img: "/icon-unique.png", data: t.name.unique, dark: true },
        { img: "/icon-apex.png", data: t.name.apex, dark: false },
      ].map((c) => (
        <button type="button" class="nm-flip" aria-pressed="false">
          <span class="nm-inner">
            <span class="nm-face nm-front">
              <img src={c.img} alt="" class="w-28 h-28 sm:w-36 sm:h-36" />
              <span class={`block text-2xl font-bold mt-2 ${c.dark ? "text-slate-800" : "text-violet-700"}`}>{c.data.title}</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-wider text-violet-500">
                {t.name.hint}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
              </span>
            </span>
            <span class="nm-face nm-back">
              <span class="block text-xl font-bold text-white">{c.data.title}</span>
              <span class="block text-violet-100 text-[15px] sm:text-base leading-relaxed mt-3 max-w-sm mx-auto">{c.data.body}</span>
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Values -->
  <div class="ab-rev ab-values mb-16 md:mb-28">
    <div class="text-center mb-8 md:mb-12">
      <p class="text-sm font-semibold text-violet-700 uppercase tracking-wide">{t.values.label}</p>
      <h2 class="text-[28px] md:text-4xl font-bold mt-3 text-slate-800">{t.values.title}</h2>
    </div>
    <!-- light, non-clickable-looking items: no boxes, no hover lift -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-8 sm:gap-x-6 max-w-5xl mx-auto">
      {t.values.items.map((item) => (
        <div class="text-center px-1 sm:px-2">
          <span class="w-14 h-14 rounded-2xl bg-violet-100 text-violet-700 flex items-center justify-center mx-auto mb-3.5">
            <Icon class="w-7 h-7" name={item.icon} />
          </span>
          <span class="block text-[15.5px] sm:text-lg font-bold text-slate-800 leading-snug">{item.title}</span>
          <span class="block text-[13px] sm:text-sm text-slate-500 leading-relaxed mt-1.5">{item.body}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* the signature: black ink, script — the font itself is loaded via <link> above */
  #ua-about .ab-sign{font-family:'Allison','Segoe Script','Brush Script MT',cursive;font-size:clamp(2.5rem,8.5vw,3.1rem);line-height:1.15;color:#111827}
  #ua-about .ab-hero{animation:abUp .7s ease both}
  @keyframes abUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  #ua-about .ab-rev{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
  #ua-about .ab-rev.ab-in{opacity:1;transform:none}
  /* ---- flippable name cards (plain CSS on purpose — bracket utilities are unreliable for 3D) ---- */
  #ua-about .nm-flip{perspective:1200px;background:transparent;border:0;padding:0;cursor:pointer;display:block;width:100%;-webkit-tap-highlight-color:transparent}
  #ua-about .nm-inner{position:relative;display:block;width:100%;min-height:300px;transition:transform .65s cubic-bezier(.35,.15,.25,1);transform-style:preserve-3d}
  #ua-about .nm-flip.nm-flipped .nm-inner{transform:rotateY(180deg)}
  #ua-about .nm-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px 26px;text-align:center}
  #ua-about .nm-front{background:#fff;border:1px solid #EDE9FE;box-shadow:0 1px 3px rgba(15,23,42,.06);transition:box-shadow .25s ease,border-color .2s ease}
  #ua-about .nm-flip:hover .nm-front{border-color:#C4B5FD;box-shadow:0 14px 30px -16px rgba(124,58,237,.3)}
  #ua-about .nm-back{background:linear-gradient(150deg,#7C3AED,#5B21B6);transform:rotateY(180deg);box-shadow:0 16px 34px -16px rgba(109,40,217,.5)}
  @media (prefers-reduced-motion: reduce){
    #ua-about .ab-hero{animation:none}
    #ua-about .ab-rev{opacity:1;transform:none;transition:none}
    #ua-about .nm-inner{transition:none}
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("ua-about");
    if (!root) return;

    // ---- Name cards: click to flip ----
    root.querySelectorAll(".nm-flip").forEach(function (b) {
      b.addEventListener("click", function () {
        var on = b.classList.toggle("nm-flipped");
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
    });

    // ---- Scroll reveals ----
    var els = root.querySelectorAll(".ab-rev");
    if (!("IntersectionObserver" in window)) {
      els.forEach(function (e) { e.classList.add("ab-in"); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("ab-in"); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: "600% 0px -8% 0px" }); /* top margin: fast-scroll safety net */
    els.forEach(function (e) { io.observe(e); });
  })();
</script>