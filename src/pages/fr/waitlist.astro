---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Liste d'attente" lang="fr">
  <Container>

    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto mt-16 mb-16">
      <p class="text-2xl font-semibold text-violet-700 uppercase tracking-wide">Liste d'attente</p>
      <h1 class="text-5xl font-bold text-slate-800 leading-tight mt-3">
        Soyez parmi les premières <span class="text-violet-700">familles</span>
      </h1>
      <p class="text-slate-600 leading-relaxed text-lg mt-6">
        UniqueApex lance son projet pilote à Montréal — mais les familles de partout peuvent s'inscrire. Dites-nous où vous êtes, et nous vous contacterons dès que l'accès s'ouvrira dans votre région.
      </p>
    </div>

    <!-- Form -->
    <div class="max-w-2xl mx-auto mb-24">
      <form
        id="waitlist-form"
        class="space-y-6"
        novalidate>

        <!-- honeypot: caché aux humains, les bots le remplissent. PAS une colonne réelle. -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden">
          <label>Company (leave empty)
            <input type="text" name="company" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <!-- About You -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">À propos de vous</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <input
                type="text"
                name="full_name"
                placeholder="Nom complet"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-full_name" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
            <div>
              <input
                type="email"
                name="email"
                placeholder="Adresse courriel"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-email" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
          </div>
          <input
            type="tel"
            name="phone"
            placeholder="Numéro de téléphone (optionnel)"
            class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
          />
          <div>
            <label class="block text-sm font-medium text-slate-600 mb-3">Langue préférée</label>
            <div class="flex gap-6">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="English" class="accent-violet-700" />
                <span class="text-slate-600">Anglais</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="French" class="accent-violet-700" />
                <span class="text-slate-600">Français</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="Both" class="accent-violet-700" />
                <span class="text-slate-600">Les deux</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="Other" class="accent-violet-700" />
                <span class="text-slate-600">Autre</span>
              </label>
            </div>
            <input
              type="text"
              name="language_other"
              id="wl-lang-other"
              placeholder="Votre langue préférée"
              style="display:none"
              class="mt-3 w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
            />
            <p id="error-language" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
          </div>
        </div>

        <!-- About Your Child -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">À propos de votre enfant</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <select
                name="child_age"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
                <option value="" disabled selected>Tranche d'âge</option>
                <option value="0-3">0 – 3 ans</option>
                <option value="4-6">4 – 6 ans</option>
                <option value="7-10">7 – 10 ans</option>
                <option value="11+">11 ans et plus</option>
              </select>
              <p id="error-child_age" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
            <div>
              <select
                name="diagnosis"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
                <option value="" disabled selected>Domaine de préoccupation</option>
                <option value="Autism">Autisme</option>
                <option value="ADHD">TDAH</option>
                <option value="Speech delay">Retard de langage</option>
                <option value="Language delay">Retard de parole</option>
                <option value="Developmental delay">Retard de développement</option>
                <option value="Other">Autre</option>
              </select>
              <p id="error-diagnosis" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-600 mb-3">Services recherchés</label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_slp" value="Speech-Language Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Orthophonie</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_ot" value="Occupational Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Ergothérapie</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_aba" value="Behavioural Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Thérapie comportementale</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_other" value="Other" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Autre</span>
              </label>
            </div>
            <input
              type="text"
              name="service_other_text"
              id="wl-service-other"
              placeholder="Quel service recherchez-vous?"
              style="display:none"
              class="mt-2 w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
            />
            <p id="error-services" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
          </div>
        </div>

        <!-- Location & Additional -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">Localisation et informations supplémentaires</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <select
                name="country"
                id="wl-country"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-600 bg-white">
                <option value="Canada" selected>Canada</option>
                <option value="United States">États-Unis</option>
                <option value="Germany">Allemagne</option>
                <option value="Austria">Autriche</option>
                <option value="Belgium">Belgique</option>
                <option value="Denmark">Danemark</option>
                <option value="Spain">Espagne</option>
                <option value="Estonia">Estonie</option>
                <option value="Finland">Finlande</option>
                <option value="France">France</option>
                <option value="Greece">Grèce</option>
                <option value="Ireland">Irlande</option>
                <option value="Italy">Italie</option>
                <option value="Luxembourg">Luxembourg</option>
                <option value="Norway">Norvège</option>
                <option value="Netherlands">Pays-Bas</option>
                <option value="Poland">Pologne</option>
                <option value="Portugal">Portugal</option>
                <option value="Romania">Roumanie</option>
                <option value="United Kingdom">Royaume-Uni</option>
                <option value="Sweden">Suède</option>
                <option value="Switzerland">Suisse</option>
                <option value="Czechia">Tchéquie</option>
                <option value="Türkiye">Turquie</option>
                <option value="Other">Autre pays</option>
              </select>
            </div>
            <div>
              <input
                type="text"
                name="location_city"
                id="wl-city"
                placeholder="Ville / arrondissement"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-location" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
          </div>
          <!-- affiché quand le pays n'est pas le Canada : s'inscrire = « on veut ça ici aussi » -->
          <p id="intl-note" style="display:none" class="text-[13.5px] leading-relaxed text-violet-800 bg-violet-50 border border-violet-100 rounded-xl px-4 py-3 m-0">
            💜 UniqueApex démarre à Montréal — en vous inscrivant depuis un autre pays, vous nous dites <b>« on veut ça ici aussi »</b>. Vous serez parmi les premiers avertis quand nous arriverons près de chez vous.
          </p>
          <select
            name="referral"
            class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
            <option value="" disabled selected>Comment avez-vous entendu parler de nous?</option>
            <option value="Social media">Réseaux sociaux</option>
            <option value="Google">Google</option>
            <option value="Friend or family">Ami(e) ou famille</option>
            <option value="Healthcare provider">Professionnel de la santé</option>
            <option value="Other">Autre</option>
          </select>
          <textarea
            name="additional_info"
            placeholder="Autre chose que vous aimeriez nous dire? (optionnel)"
            class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none h-32 focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile -->
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

        <!-- Submit -->
        <div>
          <label class="flex items-start gap-3 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 cursor-pointer mb-3">
            <input type="checkbox" id="wl-consent" class="accent-violet-700 w-4 h-4 mt-0.5 flex-shrink-0" />
            <span class="text-sm text-slate-600 leading-relaxed">
              J'accepte qu'Alpexus Technologies Ltd (UniqueApex) conserve les renseignements de ce formulaire — y compris ceux concernant mon enfant — afin de me contacter au sujet du service, comme le décrit la <a href="/fr/privacy" target="_blank" rel="noopener" class="text-violet-700 font-semibold hover:underline">Politique de confidentialité</a>. Je peux retirer mon consentement en tout temps.
            </span>
          </label>
          <p id="error-consent" style="display:none;color:#ef4444;font-size:13px;margin:0 0 12px;text-align:center">Veuillez cocher la case de consentement pour vous inscrire.</p>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAADlSug3Xc8zF8CaJ" style="margin:0 auto 12px;display:flex;justify-content:center"></div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-violet-700 hover:bg-violet-800 text-white font-semibold py-4 px-8 rounded-full transition-colors duration-200 text-lg">
            Rejoindre la liste d'attente
          </button>
          <p class="text-slate-400 text-sm text-center mt-4">Vos renseignements sont traités conformément à notre <a href="/fr/privacy" class="hover:text-violet-700 underline">Politique de confidentialité</a> — jamais vendus. Désinscription en tout temps.</p>
          <div id="waitlist-result" class="mt-4 text-center"></div>
        </div>

      </form>
    </div>

    <!-- Fenêtre modale — la politique de confidentialité s'ouvre sur place,
         sans perdre le formulaire. Contenu tiré de la vraie page /privacy
         (source unique) ; en cas d'échec, le lien s'ouvre normalement. -->
    <div id="pp-modal" role="dialog" aria-modal="true" aria-label="Politique de confidentialité" style="display:none;position:fixed;inset:0;z-index:100">
      <div id="pp-backdrop" style="position:absolute;inset:0;background:rgba(15,23,42,.55)"></div>
      <div style="position:relative;max-width:760px;max-height:85vh;margin:7.5vh auto 0;background:#fff;border-radius:20px;box-shadow:0 30px 80px rgba(15,23,42,.35);display:flex;flex-direction:column;overflow:hidden;width:calc(100% - 32px)">
        <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid #EDE9FE;flex-shrink:0">
          <b style="font-size:15px;color:#1E293B">Politique de confidentialité</b>
          <a href="/fr/privacy" target="_blank" rel="noopener" style="font-size:12.5px;color:#6D28D9;font-weight:600;text-decoration:none;margin-left:auto">Ouvrir la page complète ↗</a>
          <button id="pp-close" type="button" aria-label="Fermer" style="width:32px;height:32px;border:none;border-radius:10px;background:#F5F3FF;color:#6D28D9;font-size:18px;line-height:1;cursor:pointer">×</button>
        </div>
        <div id="pp-body" style="padding:8px 24px 28px;overflow-y:auto;font-size:14.5px;line-height:1.65;color:#334155">Chargement…</div>
      </div>
    </div>
    <style is:inline>
      #pp-body h1{font-size:1.35rem;font-weight:800;color:#1E293B;margin:18px 0 4px}
      #pp-body h2{font-size:1.02rem;font-weight:700;color:#3C3489;margin:20px 0 6px}
      #pp-body p{margin:8px 0}
      #pp-body ul{margin:8px 0;padding-left:20px}
      #pp-body a{color:#6D28D9;font-weight:600}
      #pp-body .lg-date{font-size:12.5px;color:#94A3B8}
    </style>
  </Container>
</Layout>

<script is:inline>
  var SUPABASE_URL = "https://eghqufgiudxjkbsddtnx.supabase.co";
  var SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVnaHF1ZmdpdWR4amtic2RkdG54Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNzIyOTYsImV4cCI6MjA5NDk0ODI5Nn0.0aHDnCOny0DQlE1oEgxzC__k1GKbR-XNpoMGVlyQK2I";

  var form = document.getElementById("waitlist-form");
  var result = document.getElementById("waitlist-result");
  var submitBtn = document.getElementById("submit-btn");

  // pays → affiche la note « on veut ça ici aussi » + ajuste le champ ville
  var countrySel = document.getElementById("wl-country");
  var cityInput = document.getElementById("wl-city");
  function syncCountry() {
    var v = countrySel.value;
    document.getElementById("intl-note").style.display = v === "Canada" ? "none" : "block";
    cityInput.placeholder = v === "Canada" ? "Ville / arrondissement" : (v === "Other" ? "Ville, Pays" : "Ville (optionnel)");
  }
  countrySel.addEventListener("change", syncCountry);
  syncCountry();

  // langue « Autre » → champ pour la préciser
  var langOtherInput = document.getElementById("wl-lang-other");
  document.querySelectorAll('input[name="language"]').forEach(function (r) {
    r.addEventListener("change", function () {
      langOtherInput.style.display = (this.checked && this.value === "Other") ? "block" : "none";
    });
  });
  // service « Autre » → champ pour le préciser
  var svcOtherCheck = document.querySelector('input[name="service_other"]');
  var svcOtherInput = document.getElementById("wl-service-other");
  svcOtherCheck.addEventListener("change", function () {
    svcOtherInput.style.display = this.checked ? "block" : "none";
  });

  // protections anti-bots
  var formLoadTime = Date.now();
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(id, msg) {
    var el = document.getElementById(id);
    if (el) {
      el.textContent = msg;
      el.style.display = "block";
    }
  }

  function clearErrors() {
    var ids = ["error-full_name","error-email","error-language","error-child_age","error-diagnosis","error-services","error-location","error-consent"];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el) { el.textContent = ""; el.style.display = "none"; }
    }
  }

  function fakeSuccess() {
    // bot détecté — on fait semblant que ça a marché, mais on n'envoie rien
    result.innerHTML = "<span style='color:#22c55e;font-weight:500'>Vous êtes sur la liste d'attente! Nous vous contacterons bientôt.</span>";
    form.reset();
    submitBtn.disabled = true;
    submitBtn.textContent = "Inscription complétée!";
  }

  form.addEventListener("submit", function(e) {
    e.preventDefault();
    e.stopPropagation();
    clearErrors();

    var formData = new FormData(form);

    // --- contrôles anti-bots : honeypot rempli, ou envoi trop rapide ---
    var honey = formData.get("company");
    var tooFast = (Date.now() - formLoadTime) < 2500;
    if ((honey && honey.trim() !== "") || tooFast) {
      fakeSuccess();
      return false;
    }

    var valid = true;

    var fullName = formData.get("full_name");
    if (!fullName || fullName.trim() === "") {
      showError("error-full_name", "Veuillez entrer votre nom complet.");
      valid = false;
    }

    var email = formData.get("email");
    if (!email || !EMAIL_RE.test(email.trim())) {
      showError("error-email", "Veuillez entrer une adresse courriel valide.");
      valid = false;
    }

    var language = formData.get("language");
    var languageValue = language;
    if (!language) {
      showError("error-language", "Veuillez sélectionner une langue préférée.");
      valid = false;
    } else if (language === "Other") {
      var langTyped = (formData.get("language_other") || "").trim();
      if (langTyped === "") {
        showError("error-language", "Veuillez indiquer votre langue préférée.");
        valid = false;
      } else {
        languageValue = langTyped;
      }
    }

    var childAge = formData.get("child_age");
    if (!childAge) {
      showError("error-child_age", "Veuillez sélectionner une tranche d'âge.");
      valid = false;
    }

    var diagnosis = formData.get("diagnosis");
    if (!diagnosis) {
      showError("error-diagnosis", "Veuillez sélectionner un domaine de préoccupation.");
      valid = false;
    }

    var slp = formData.get("service_slp");
    var ot = formData.get("service_ot");
    var aba = formData.get("service_aba");
    var other = formData.get("service_other");
    if (!slp && !ot && !aba && !other) {
      showError("error-services", "Veuillez sélectionner au moins un service.");
      valid = false;
    }
    var svcOtherTyped = (formData.get("service_other_text") || "").trim();
    if (other && svcOtherTyped === "") {
      showError("error-services", "Veuillez préciser le service recherché.");
      valid = false;
    }

    var country = formData.get("country") || "Canada";
    var city = (formData.get("location_city") || "").trim();
    if (country === "Canada" && city === "") {
      showError("error-location", "Veuillez entrer votre ville ou arrondissement.");
      valid = false;
    }
    if (country === "Other" && city === "") {
      showError("error-location", "Veuillez indiquer votre ville et votre pays.");
      valid = false;
    }
    // le pays voyage dans le champ location existant — aucun changement backend requis
    var locationValue = country === "Canada" ? city : (country === "Other" ? city : (city === "" ? country : city + ", " + country));

    if (!document.getElementById("wl-consent").checked) {
      showError("error-consent", "Veuillez cocher la case de consentement pour vous inscrire.");
      valid = false;
    }

    if (!valid) {
      return false;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Envoi en cours...";
    result.innerHTML = "";

    var token = (window.turnstile && window.turnstile.getResponse) ? window.turnstile.getResponse() : "";
    if (!token) {
      result.innerHTML = "<span style='color:#ef4444'>Veuillez compléter la vérification ci-dessus.</span>";
      submitBtn.disabled = false;
      submitBtn.textContent = "Rejoindre la liste d'attente";
      return false;
    }

    var data = {
      full_name: formData.get("full_name") || null,
      email: formData.get("email") || null,
      phone: formData.get("phone") || null,
      language: languageValue || null,
      child_age: formData.get("child_age") || null,
      diagnosis: formData.get("diagnosis") || null,
      service_slp: formData.get("service_slp") || null,
      service_ot: formData.get("service_ot") || null,
      service_aba: formData.get("service_aba") || null,
      service_other: other ? svcOtherTyped : null,
      location: locationValue || null,
      referral: formData.get("referral") || null,
      additional_info: formData.get("additional_info") || null,
      company: honey || null,
      turnstileToken: token
    };

    fetch(SUPABASE_URL + "/functions/v1/waitlist-submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", "apikey": SUPABASE_KEY },
      body: JSON.stringify(data)
    }).then(function(response) {
      return response.json().catch(function(){ return { ok: response.ok }; });
    }).then(function(out) {
      if (out && out.ok) {
        result.innerHTML = "<span style='color:#22c55e;font-weight:500'>Vous êtes sur la liste d'attente! Nous vous contacterons bientôt.</span>";
        form.reset();
        submitBtn.textContent = "Inscription complétée!";
      } else {
        result.innerHTML = "<span style='color:#ef4444'>Une erreur est survenue. Veuillez réessayer.</span>";
        submitBtn.disabled = false;
        submitBtn.textContent = "Rejoindre la liste d'attente";
        if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
      }
    }).catch(function() {
      result.innerHTML = "<span style='color:#ef4444'>Une erreur est survenue. Veuillez réessayer.</span>";
      submitBtn.disabled = false;
      submitBtn.textContent = "Rejoindre la liste d'attente";
      if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
    });

  });

  /* ---------- Fenêtre modale de la politique de confidentialité ---------- */
  (function () {
    var modal = document.getElementById("pp-modal");
    var body = document.getElementById("pp-body");
    var closeBtn = document.getElementById("pp-close");
    var backdrop = document.getElementById("pp-backdrop");
    if (!modal) return;
    var loaded = false, lastFocus = null;

    function openModal() {
      lastFocus = document.activeElement;
      modal.style.display = "block";
      document.documentElement.style.overflow = "hidden";
      closeBtn.focus();
      if (loaded) return;
      fetch("/privacy/").then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, "text/html");
        var article = doc.getElementById("doc-fr");
        if (!article) throw new Error("no article");
        article.removeAttribute("hidden");
        article.querySelectorAll("a[href]").forEach(function (a) {
          if ((a.getAttribute("href") || "").indexOf("mailto:") !== 0) { a.target = "_blank"; a.rel = "noopener"; }
        });
        body.innerHTML = article.innerHTML;
        loaded = true;
      }).catch(function () {
        closeModal();
        window.open("/fr/privacy", "_blank", "noopener");
      });
    }
    function closeModal() {
      modal.style.display = "none";
      document.documentElement.style.overflow = "";
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    document.querySelectorAll('a[href="/fr/privacy"]').forEach(function (a) {
      if (modal.contains(a)) return;
      a.addEventListener("click", function (e) { e.preventDefault(); openModal(); });
    });
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && modal.style.display === "block") closeModal(); });
  })();
</script>
