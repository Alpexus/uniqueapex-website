---
/* SIGNUP — GATED FOR LAUNCH.
   Account creation is closed while the pilot waitlist is open: the app
   is not ready for families yet, so this page now sends visitors to the
   waitlist instead of creating accounts.
   The full onboarding form (parent account + child profile + Turnstile →
   signup-submit edge function) lives in git history — restore the previous
   version of this file when the pilot opens.
   Bilingual: /signup (EN) and /fr/signup (FR) render this same page with
   a lang prop. ALSO disable "Allow new users to sign up" in Supabase Auth
   settings so the API path is closed too. */
import Layout from "@/layouts/Layout.astro";

const { lang = "en" } = Astro.props;
const prefix = lang === "fr" ? "/fr" : "";

const t = {
  en: {
    title: "Coming Soon",
    badge: "Coming soon",
    heading1: "Family accounts open",
    heading2: "with our Montréal pilot",
    body: "We're welcoming our first families through the waitlist right now. Join it and you'll be among the first invited when doors open — and we'll keep you posted along the way.",
    cta: "Join the Waitlist",
    home: "Back to home",
    signin: "Already have an account?",
    signinLink: "Sign in",
  },
  fr: {
    title: "Bientôt disponible",
    badge: "Bientôt",
    heading1: "Les comptes familles ouvrent",
    heading2: "avec notre pilote à Montréal",
    body: "Nous accueillons nos premières familles par la liste d'attente en ce moment. Inscrivez-vous et vous serez parmi les premières invitées à l'ouverture — nous vous tiendrons au courant.",
    cta: "Rejoindre la liste d'attente",
    home: "Retour à l'accueil",
    signin: "Vous avez déjà un compte?",
    signinLink: "Connectez-vous",
  },
}[lang === "fr" ? "fr" : "en"];
---

<Layout title={t.title} lang={lang}>
  <div class="max-w-xl mx-auto text-center px-6 pt-24 pb-32">
    <span class="inline-block text-xs font-bold uppercase tracking-wide text-violet-700 bg-violet-100 rounded-full px-4 py-1.5 mb-6">✦ {t.badge}</span>
    <h1 class="text-4xl md:text-5xl font-bold text-slate-800 leading-tight">
      {t.heading1} <span class="text-violet-700">{t.heading2}</span>
    </h1>
    <p class="text-slate-600 leading-relaxed text-lg mt-6 mb-10">{t.body}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={prefix + "/waitlist"} class="bg-violet-700 hover:bg-violet-800 text-white font-semibold py-3.5 px-8 rounded-full transition-colors">{t.cta}</a>
      <a href={prefix + "/"} class="border-2 border-violet-200 text-violet-700 hover:bg-violet-50 font-semibold py-3.5 px-8 rounded-full transition-colors">{t.home}</a>
    </div>
    <p class="text-sm text-slate-400 mt-10">{t.signin} <a href={"/signin" + (lang === "fr" ? "?lang=fr" : "")} class="text-violet-700 font-semibold hover:underline">{t.signinLink}</a></p>
  </div>
</Layout>
