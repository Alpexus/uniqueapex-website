---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Join the Waitlist">
  <Container>

    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto mt-16 mb-16">
      <p class="text-2xl font-semibold text-violet-700 uppercase tracking-wide">Join the Waitlist</p>
      <h1 class="text-5xl font-bold text-slate-800 leading-tight mt-3">
        Be among the first <span class="text-violet-700">families in Montréal</span>
      </h1>
      <p class="text-slate-600 leading-relaxed text-lg mt-6">
        UniqueApex is launching its pilot in Montréal. Join the waitlist and we will reach out as soon as access opens in your area.
      </p>
    </div>

    <!-- Form -->
    <div class="max-w-2xl mx-auto mb-24">
      <form
        id="waitlist-form"
        class="space-y-6"
        novalidate>

        <!-- honeypot: hidden from people, bots tend to fill it. NOT a real table column. -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden">
          <label>Company (leave empty)
            <input type="text" name="company" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <!-- About You -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">About you</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <input
                type="text"
                name="full_name"
                placeholder="Full Name"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-full_name" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
            <div>
              <input
                type="email"
                name="email"
                placeholder="Email Address"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-email" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
          </div>
          <input
            type="tel"
            name="phone"
            placeholder="Phone Number (optional)"
            class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
          />
          <div>
            <label class="block text-sm font-medium text-slate-600 mb-3">Preferred Language</label>
            <div class="flex gap-6">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="English" class="accent-violet-700" />
                <span class="text-slate-600">English</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="French" class="accent-violet-700" />
                <span class="text-slate-600">French</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="language" value="Both" class="accent-violet-700" />
                <span class="text-slate-600">Both</span>
              </label>
            </div>
            <p id="error-language" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
          </div>
        </div>

        <!-- About Your Child -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">About your child</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <select
                name="child_age"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
                <option value="" disabled selected>Age Range</option>
                <option value="0-3">0 – 3 years</option>
                <option value="4-6">4 – 6 years</option>
                <option value="7-10">7 – 10 years</option>
                <option value="11+">11 years and older</option>
              </select>
              <p id="error-child_age" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
            <div>
              <select
                name="diagnosis"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
                <option value="" disabled selected>Area of Concern</option>
                <option value="Autism">Autism</option>
                <option value="ADHD">ADHD</option>
                <option value="Speech delay">Speech delay</option>
                <option value="Language delay">Language delay</option>
                <option value="Developmental delay">Developmental delay</option>
                <option value="Other">Other</option>
              </select>
              <p id="error-diagnosis" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-600 mb-3">Services Needed</label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_slp" value="Speech-Language Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Speech-Language Therapy</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_ot" value="Occupational Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Occupational Therapy</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_aba" value="Behavioural Therapy" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Behavioural Therapy</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-violet-300 transition-colors">
                <input type="checkbox" name="service_other" value="Other" class="accent-violet-700 w-4 h-4" />
                <span class="text-slate-600 text-sm">Other</span>
              </label>
            </div>
            <p id="error-services" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
          </div>
        </div>

        <!-- Location & Additional -->
        <div class="bg-slate-50 rounded-2xl p-8 space-y-4">
          <h2 class="text-lg font-bold text-slate-800">Location & additional info</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <input
                type="text"
                name="location"
                placeholder="City / Borough in Montréal"
                class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
              />
              <p id="error-location" style="display:none;color:#ef4444;font-size:12px;margin-top:4px"></p>
            </div>
            <select
              name="referral"
              class="w-full px-4 py-3 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-400 text-slate-500 bg-white">
              <option value="" disabled selected>How did you hear about us?</option>
              <option value="Social media">Social media</option>
              <option value="Google">Google</option>
              <option value="Friend or family">Friend or family</option>
              <option value="Healthcare provider">Healthcare provider</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <textarea
            name="additional_info"
            placeholder="Anything else you'd like us to know? (optional)"
            class="w-full px-4 py-3 border border-slate-200 placeholder:text-slate-400 rounded-xl outline-none h-32 focus:ring-2 focus:ring-violet-300 focus:border-violet-400 bg-white"
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile -->
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

        <!-- Submit -->
        <div>
          <label class="flex items-start gap-3 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 cursor-pointer mb-3">
            <input type="checkbox" id="wl-consent" class="accent-violet-700 w-4 h-4 mt-0.5 flex-shrink-0" />
            <span class="text-sm text-slate-600 leading-relaxed">
              I consent to Alpexus Technologies Ltd (UniqueApex) storing the information in this form — including details about my child — to contact me about the service, as described in the <a href="/privacy" target="_blank" rel="noopener" class="text-violet-700 font-semibold hover:underline">Privacy Policy</a>. I can withdraw at any time.
            </span>
          </label>
          <p id="error-consent" style="display:none;color:#ef4444;font-size:13px;margin:0 0 12px;text-align:center">Please tick the consent box to join.</p>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAADlSug3Xc8zF8CaJ" style="margin:0 auto 12px;display:flex;justify-content:center"></div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-violet-700 hover:bg-violet-800 text-white font-semibold py-4 px-8 rounded-full transition-colors duration-200 text-lg">
            Join the Waitlist
          </button>
          <p class="text-slate-400 text-sm text-center mt-4">Your information is handled as described in our <a href="/privacy" class="hover:text-violet-700 underline">Privacy Policy</a> — never sold, never used for ads. Unsubscribe anytime.</p>
          <div id="waitlist-result" class="mt-4 text-center"></div>
        </div>

      </form>
    </div>

    <!-- Privacy Policy modal — opens the policy in place so nobody loses the form.
         Content is pulled from the real /privacy page (single source of truth);
         if anything fails, the link falls back to opening the page normally. -->
    <div id="pp-modal" role="dialog" aria-modal="true" aria-label="Privacy Policy" style="display:none;position:fixed;inset:0;z-index:100">
      <div id="pp-backdrop" style="position:absolute;inset:0;background:rgba(15,23,42,.55)"></div>
      <div style="position:relative;max-width:760px;max-height:85vh;margin:7.5vh auto 0;background:#fff;border-radius:20px;box-shadow:0 30px 80px rgba(15,23,42,.35);display:flex;flex-direction:column;overflow:hidden;width:calc(100% - 32px)">
        <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid #EDE9FE;flex-shrink:0">
          <b style="font-size:15px;color:#1E293B">Privacy Policy</b>
          <a href="/privacy" target="_blank" rel="noopener" style="font-size:12.5px;color:#6D28D9;font-weight:600;text-decoration:none;margin-left:auto">Open full page ↗</a>
          <button id="pp-close" type="button" aria-label="Close" style="width:32px;height:32px;border:none;border-radius:10px;background:#F5F3FF;color:#6D28D9;font-size:18px;line-height:1;cursor:pointer">×</button>
        </div>
        <div id="pp-body" style="padding:8px 24px 28px;overflow-y:auto;font-size:14.5px;line-height:1.65;color:#334155">Loading…</div>
      </div>
    </div>
    <style is:inline>
      #pp-body h1{font-size:1.35rem;font-weight:800;color:#1E293B;margin:18px 0 4px}
      #pp-body h2{font-size:1.02rem;font-weight:700;color:#3C3489;margin:20px 0 6px}
      #pp-body p{margin:8px 0}
      #pp-body ul{margin:8px 0;padding-left:20px}
      #pp-body a{color:#6D28D9;font-weight:600}
      #pp-body .lg-date{font-size:12.5px;color:#94A3B8}
    </style>
  </Container>
</Layout>

<script is:inline>
  const SUPABASE_URL = "https://eghqufgiudxjkbsddtnx.supabase.co";
  const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVnaHF1ZmdpdWR4amtic2RkdG54Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNzIyOTYsImV4cCI6MjA5NDk0ODI5Nn0.0aHDnCOny0DQlE1oEgxzC__k1GKbR-XNpoMGVlyQK2I";

  var form = document.getElementById("waitlist-form");
  var result = document.getElementById("waitlist-result");
  var submitBtn = document.getElementById("submit-btn");

  // bot defenses
  var formLoadTime = Date.now();
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(id, msg) {
    var el = document.getElementById(id);
    if (el) {
      el.textContent = msg;
      el.style.display = "block";
    }
  }

  function clearErrors() {
    var ids = ["error-full_name","error-email","error-language","error-child_age","error-diagnosis","error-services","error-location","error-consent"];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el) { el.textContent = ""; el.style.display = "none"; }
    }
  }

  function fakeSuccess() {
    // bot detected — pretend it worked so they move on, but never POST
    result.innerHTML = "<span style='color:#22c55e;font-weight:500'>You are on the waitlist! We will be in touch soon.</span>";
    form.reset();
    submitBtn.disabled = true;
    submitBtn.textContent = "Submitted!";
  }

  form.addEventListener("submit", function(e) {
    e.preventDefault();
    e.stopPropagation();
    clearErrors();

    var formData = new FormData(form);

    // --- bot checks: honeypot filled, or submitted impossibly fast ---
    var honey = formData.get("company");
    var tooFast = (Date.now() - formLoadTime) < 2500;
    if ((honey && honey.trim() !== "") || tooFast) {
      fakeSuccess();
      return false;
    }

    var valid = true;

    var fullName = formData.get("full_name");
    if (!fullName || fullName.trim() === "") {
      showError("error-full_name", "Please enter your full name.");
      valid = false;
    }

    var email = formData.get("email");
    if (!email || !EMAIL_RE.test(email.trim())) {
      showError("error-email", "Please enter a valid email address.");
      valid = false;
    }

    var language = formData.get("language");
    if (!language) {
      showError("error-language", "Please select a preferred language.");
      valid = false;
    }

    var childAge = formData.get("child_age");
    if (!childAge) {
      showError("error-child_age", "Please select an age range.");
      valid = false;
    }

    var diagnosis = formData.get("diagnosis");
    if (!diagnosis) {
      showError("error-diagnosis", "Please select an area of concern.");
      valid = false;
    }

    var slp = formData.get("service_slp");
    var ot = formData.get("service_ot");
    var aba = formData.get("service_aba");
    var other = formData.get("service_other");
    if (!slp && !ot && !aba && !other) {
      showError("error-services", "Please select at least one service.");
      valid = false;
    }

    var location = formData.get("location");
    if (!location || location.trim() === "") {
      showError("error-location", "Please enter your city or borough.");
      valid = false;
    }

    if (!document.getElementById("wl-consent").checked) {
      showError("error-consent", "Please tick the consent box to join.");
      valid = false;
    }

    if (!valid) {
      return false;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Submitting...";
    result.innerHTML = "";

    var token = (window.turnstile && window.turnstile.getResponse) ? window.turnstile.getResponse() : "";
    if (!token) {
      result.innerHTML = "<span style='color:#ef4444'>Please complete the verification box above.</span>";
      submitBtn.disabled = false;
      submitBtn.textContent = "Join the Waitlist";
      return false;
    }

    var data = {
      full_name: formData.get("full_name") || null,
      email: formData.get("email") || null,
      phone: formData.get("phone") || null,
      language: formData.get("language") || null,
      child_age: formData.get("child_age") || null,
      diagnosis: formData.get("diagnosis") || null,
      service_slp: formData.get("service_slp") || null,
      service_ot: formData.get("service_ot") || null,
      service_aba: formData.get("service_aba") || null,
      service_other: formData.get("service_other") || null,
      location: formData.get("location") || null,
      referral: formData.get("referral") || null,
      additional_info: formData.get("additional_info") || null,
      company: honey || null,
      turnstileToken: token
    };

    fetch(SUPABASE_URL + "/functions/v1/waitlist-submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", "apikey": SUPABASE_KEY },
      body: JSON.stringify(data)
    }).then(function(response) {
      return response.json().catch(function(){ return { ok: response.ok }; });
    }).then(function(out) {
      if (out && out.ok) {
        result.innerHTML = "<span style='color:#22c55e;font-weight:500'>You are on the waitlist! We will be in touch soon.</span>";
        form.reset();
        submitBtn.textContent = "Submitted!";
      } else {
        result.innerHTML = "<span style='color:#ef4444'>Something went wrong. Please try again.</span>";
        submitBtn.disabled = false;
        submitBtn.textContent = "Join the Waitlist";
        if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
      }
    }).catch(function() {
      result.innerHTML = "<span style='color:#ef4444'>Something went wrong. Please try again.</span>";
      submitBtn.disabled = false;
      submitBtn.textContent = "Join the Waitlist";
      if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
    });

  });

  /* ---------- Privacy Policy modal (in-page, form state preserved) ---------- */
  (function () {
    var modal = document.getElementById("pp-modal");
    var body = document.getElementById("pp-body");
    var closeBtn = document.getElementById("pp-close");
    var backdrop = document.getElementById("pp-backdrop");
    if (!modal) return;
    var loaded = false, lastFocus = null;

    function openModal() {
      lastFocus = document.activeElement;
      modal.style.display = "block";
      document.documentElement.style.overflow = "hidden";
      closeBtn.focus();
      if (loaded) return;
      fetch("/privacy/").then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, "text/html");
        var article = doc.getElementById("doc-en");
        if (!article) throw new Error("no article");
        article.removeAttribute("hidden");
        /* links inside the policy open in a new tab so the form is never lost */
        article.querySelectorAll("a[href]").forEach(function (a) {
          if ((a.getAttribute("href") || "").indexOf("mailto:") !== 0) { a.target = "_blank"; a.rel = "noopener"; }
        });
        body.innerHTML = article.innerHTML;
        loaded = true;
      }).catch(function () {
        closeModal();
        window.open("/privacy", "_blank", "noopener");
      });
    }
    function closeModal() {
      modal.style.display = "none";
      document.documentElement.style.overflow = "";
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    document.querySelectorAll('a[href="/privacy"]').forEach(function (a) {
      if (modal.contains(a)) return; /* the "Open full page" link keeps its normal behaviour */
      a.addEventListener("click", function (e) { e.preventDefault(); openModal(); });
    });
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && modal.style.display === "block") closeModal(); });
  })();
</script>
